#
# Meetza Admin Dashboard (.env.example)
# Copy this file to ".env" and edit values as needed.
#
# Windows (PowerShell):
#   Copy-Item .env.example .env
#

# Backend REST API base URL (must include /api)
REACT_APP_API_BASE=http://localhost:4000/api

# Optional: Google reCAPTCHA site key (leave empty if not used)
REACT_APP_RECAPTCHA_SITE_KEY=
